"""
Utilities corresponding to system utilities such as the system clock.
"""

load("@io_bazel_rules_kotlin//kotlin:android.bzl", "kt_android_library")

kt_android_library(
    name = "oppia_clock",
    srcs = [
        "OppiaClock.kt",
    ],
    visibility = ["//:oppia_api_visibility"],
)

kt_android_library(
    name = "oppia_clock_impl",
    srcs = [
        "OppiaClockImpl.kt",
    ],
    deps = [
        ":oppia_clock",
        "//third_party:javax_inject_javax_inject",
    ],
)

kt_android_library(
    name = "prod_module",
    srcs = [
        "OppiaClockModule.kt",
    ],
    visibility = ["//:oppia_prod_module_visibility"],
    deps = [
        ":oppia_clock_impl",
        "//:dagger",
    ],
)

kt_android_library(
    name = "oppia_clock_injector",
    srcs = [
        "OppiaClockInjector.kt",
    ],
    visibility = ["//:oppia_api_visibility"],
    deps = [
        ":oppia_clock",
    ],
)

kt_android_library(
    name = "oppia_clock_injector_provider",
    srcs = [
        "OppiaClockInjectorProvider.kt",
    ],
    visibility = ["//:oppia_api_visibility"],
    deps = [
        ":oppia_clock_injector",
    ],
)

kt_android_library(
    name = "terminal_controller",
    srcs = [
        "TerminalController.kt",
    ],
    visibility = ["//:oppia_api_visibility"],
)

kt_android_library(
    name = "terminal_controller_impl",
    srcs = [
        "TerminalControllerImpl.kt",
    ],
    deps = [
        ":terminal_controller",
        "//third_party:javax_inject_javax_inject",
    ],
)

kt_android_library(
    name = "terminal_controller_module",
    srcs = [
        "TerminalControllerModule.kt",
    ],
    visibility = ["//:oppia_prod_module_visibility"],
    deps = [
        ":terminal_controller_impl",
        "//:dagger",
    ],
)
