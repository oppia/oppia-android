<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>
    <variable
      name="htmlContent"
      type="CharSequence" />
    <variable
      name="viewModel"
      type="org.oppia.android.app.player.state.itemviewmodel.SelectionSubmittedItemViewModel" />
  </data>

  <FrameLayout
    android:id="@+id/option_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
      android:id="@+id/checkbox_container"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:importantForAccessibility="yes"
      android:minHeight="48dp"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:paddingTop="12dp"
      android:paddingBottom="12dp"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/multiple_choice_radio_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        app:srcCompat="@{viewModel.isEnabled ? @drawable/rect_radio_checked : @drawable/rect_radio_unchecked}" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
          android:id="@+id/item_selection_content_text_view"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:text="@{htmlContent}"
          android:contentDescription="@{viewModel.getContentDescription()}"
          android:textColor="@{viewModel.isEnabled ? @color/component_color_shared_selected_submitted_answer_text_color : @color/component_color_shared_secondary_2_text_color}"
          android:textSize="16sp" />

        <TextView
          android:id="@+id/submitted_answer_label_text_view"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:visibility="gone"
          android:fontFamily="sans-serif"
          android:text="@string/submitted_answer_label_text"
          android:textColor="@{viewModel.isEnabled ? @color/component_color_shared_selected_submitted_answer_text_color : @color/component_color_shared_secondary_2_text_color}"
          android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>

    <View
      android:id="@+id/submitted_answer_highlight_overlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/component_color_exploration_activity_selected_submitted_answer_overlay_color"
      android:visibility="gone" />
  </FrameLayout>
</layout>
