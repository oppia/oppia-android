<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <import type="android.view.View" />

    <import type="org.oppia.android.app.topic.studyguide.StudyGuideViewModel.NavigationCardType" />

    <variable
      name="viewModel"
      type="org.oppia.android.app.topic.studyguide.StudyGuideViewModel" />
  </data>

  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/component_color_shared_screen_secondary_background_color"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingBottom="@dimen/study_guide_fragment_padding_bottom">

      <!--
        Hosts the study guide's ordered sections. Each section contributes a SECTION_HEADING and a
        SECTION_CONTENT item, bound through a BindableAdapter in StudyGuideFragmentPresenter. Nested
        scrolling is disabled so the parent NestedScrollView scrolls the sections and the navigation
        cards together (mirrors the revision card screen).
      -->
      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/study_guide_section_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:data="@{viewModel.sectionItemsLiveData}"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

      <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/study_guide_navigation_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp">

        <TextView
          android:id="@+id/study_guide_continue_studying_text_view"
          style="@style/TextViewStart"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="28dp"
          android:layout_marginEnd="28dp"
          android:text="@string/revision_navigation_cards_header"
          android:textAlignment="@{viewModel.subtopicIndex == 1 ? View.TEXT_ALIGNMENT_TEXT_END : View.TEXT_ALIGNMENT_TEXT_START}"
          android:textColor="@color/component_color_shared_primary_text_color"
          android:textSize="20sp"
          android:textStyle="bold"
          android:visibility="@{viewModel.subtopicListSize == 1 ? View.INVISIBLE : View.VISIBLE}"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/study_guide_previous_navigation_button"
          style="@style/Widget.MaterialComponents.Button.TextButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="28dp"
          android:layout_marginTop="16dp"
          android:layout_marginBottom="@dimen/topic_revision_summary_view_container_margin_bottom"
          android:contentDescription="@{viewModel.computeContentDescriptionText(NavigationCardType.PREVIOUS, viewModel.previousSubtopicLiveData)}"
          android:minHeight="48dp"
          android:onClick="@{() -> viewModel.onPreviousCardClicked()}"
          android:text="@string/study_guide_previous_skill"
          android:textAllCaps="false"
          android:textColor="@color/component_color_shared_primary_text_color"
          android:visibility="@{viewModel.subtopicIndex == 1 ? View.GONE : View.VISIBLE}"
          app:icon="@drawable/ic_arrow_back_black_24_dp"
          app:iconGravity="textStart"
          app:iconTint="@color/component_color_shared_primary_text_color"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/study_guide_continue_studying_text_view" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/study_guide_next_navigation_button"
          style="@style/Widget.MaterialComponents.Button.TextButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:layout_marginEnd="28dp"
          android:layout_marginBottom="@dimen/topic_revision_summary_view_container_margin_bottom"
          android:contentDescription="@{viewModel.computeContentDescriptionText(NavigationCardType.NEXT, viewModel.nextSubtopicLiveData)}"
          android:minHeight="48dp"
          android:onClick="@{() -> viewModel.onNextCardClicked()}"
          android:text="@string/study_guide_next_skill"
          android:textAllCaps="false"
          android:textColor="@color/component_color_shared_primary_text_color"
          android:visibility="@{viewModel.subtopicIndex &lt; viewModel.subtopicListSize ? View.VISIBLE : View.GONE}"
          app:icon="@drawable/ic_arrow_forward_black_24dp"
          app:iconGravity="textEnd"
          app:iconTint="@color/component_color_shared_primary_text_color"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toBottomOf="@id/study_guide_continue_studying_text_view" />
      </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</layout>
