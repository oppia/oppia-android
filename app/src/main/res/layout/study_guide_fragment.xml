<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

  <data>

    <variable
      name="viewModel"
      type="org.oppia.android.app.topic.studyguide.StudyGuideViewModel" />
  </data>

  <!--
    Scaffolding container for the study guide. The section list (SECTION_HEADING / SECTION_CONTENT
    items via a BindableAdapter) is wired up in the next task of PR 1.4 (#6104), and the
    Previous/Next subtopic navigation cards are added in the task after that.
  -->
  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/study_guide_section_recycler_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/component_color_shared_screen_secondary_background_color"
    android:overScrollMode="never"
    android:scrollbars="none" />
</layout>
