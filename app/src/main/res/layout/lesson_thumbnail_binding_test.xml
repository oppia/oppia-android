<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>
    <variable
      name="entityId"
      type="String" />

    <variable
      name="entityType"
      type="String" />

    <variable
      name="lessonThumbnail"
      type="org.oppia.android.app.model.LessonThumbnail" />
  </data>

  <org.oppia.android.app.customview.LessonThumbnailImageView
    android:id="@+id/thumbnail_image"
    android:layout_width="120dp"
    android:layout_height="80dp"
    app:entityId="@{entityId}"
    app:entityType="@{entityType}"
    app:lessonThumbnail="@{lessonThumbnail}" />
</layout>
