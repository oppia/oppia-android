<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <data>

    <variable
      name="viewModel"
      type="org.oppia.android.app.player.state.itemviewmodel.LessonProgressViewModel" />
  </data>

  <org.oppia.android.app.customview.LessonProgressIndicatorView
    android:id="@+id/lesson_progress_indicator"
    android:layout_width="match_parent"
    android:layout_height="20dp"
    android:layout_marginStart="24dp"
    android:layout_marginTop="20dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="0dp"
    android:contentDescription="@{viewModel.contentDescription}"
    app:lessonProgressCompletedCount="@{viewModel.completedCount}"
    app:lessonProgressTotalCount="@{viewModel.totalCount}" />
</layout>
