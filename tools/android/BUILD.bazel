"""
Imports required data-binding annotation processor.
"""

load("@rules_java//java:defs.bzl", "java_plugin")
load("@io_bazel_rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")

java_plugin(
    name = "compiler_annotation_processor",
    generates_api = True,
    processor_class = "android.databinding.annotationprocessor.ProcessDataBinding",
    visibility = ["//visibility:public"],
    deps = [
        "@bazel_tools//src/tools/android/java/com/google/devtools/build/android:all_android_tools",
    ],
)

kt_jvm_library(
    name = "r8_wrapper_lib",
    srcs = ["OppiaR8Wrapper.kt"],
    deps = ["//third_party:com_android_tools_r8"],
)

java_binary(
    name = "r8_compat_proguard",
    main_class = "org.oppia.android.tools.android.OppiaR8WrapperKt",
    visibility = ["//visibility:public"],
    runtime_deps = [":r8_wrapper_lib"],
)

toolchain(
    name = "legacy_sdk_toolchain",
    toolchain = "@androidsdk//:sdk-35",
    toolchain_type = "@bazel_tools//tools/android:sdk_toolchain_type",
)

genrule(
    name = "databinding_api_jar_gen",
    srcs = ["@android_tools//:all_android_tools_deploy.jar"],
    outs = ["databinding_api.jar"],
    cmd = "mkdir -p tmp && cd tmp && unzip -q ../$< android/databinding/BindingBuildInfo.class android/databinding/BindingAdapter.class android/databinding/InverseBindingAdapter.class && zip -q ../$@ -r android/databinding/BindingBuildInfo.class android/databinding/BindingAdapter.class android/databinding/InverseBindingAdapter.class",
)

java_import(
    name = "databinding_api",
    jars = [":databinding_api.jar"],
    visibility = ["//visibility:public"],
)
