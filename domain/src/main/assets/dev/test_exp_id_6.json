      "IsEquivalentTo Practice 1": {
        "content": {
          "content_id": "content_101",
          "html": "<p>\u201cThere\u2019s another way to check units too,\u201d Coach Kim said. \u201cTwo measurements can be equivalent even if they\u2019re written with completely different units \u2014 as long as they represent the same real-world amount. For example, 3 m and 300 cm describe the exact same distance, so they\u2019re equivalent.\u201d</p><p>\u201cTry it yourself: enter a measurement equivalent to 3 m, written in centimeters.\u201d</p>"
        },
        "interaction": {
          "id": "NumberWithUnits",
          "customization_args": {},
          "answer_groups": [
            {
              "rule_specs": [
                {
                  "rule_type": "IsEquivalentTo",
                  "inputs": {
                    "f": {
                      "real": 3.0,
                      "type": "real",
                      "units": [
                        {
                          "exponent": 1,
                          "unit": "m"
                        }
                      ]
                    }
                  }
                }
              ],
              "outcome": {
                "dest": "IsEquivalentTo Practice 2",
                "feedback": {
                  "content_id": "feedback_102",
                  "html": "<p>Correct! 300 cm is equivalent to 3 m.</p>"
                },
                "labelled_as_correct": true
              }
            }
          ],
          "default_outcome": {
            "dest": "IsEquivalentTo Practice 1",
            "feedback": {
              "content_id": "default_outcome_103",
              "html": "<p>No, that's not correct. Remember, 1 m = 100 cm, so find the same distance in centimeters.</p>"
            },
            "labelled_as_correct": false
          },
          "hints": [
            {
              "hint_content": {
                "content_id": "hint_104",
                "html": "<p>Multiply 3 by 100 to convert meters to centimeters.</p>"
              }
            }
          ],
          "solution": null
