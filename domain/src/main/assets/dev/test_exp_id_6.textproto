states {
  key: "Unit Conversion 2"
  value {
    name: "Unit Conversion 2"
    content {
      html: "<p>\342\200\234Good job, Omar,\342\200\235 Coach Kim said. \342\200\234Now you know that 1km = 1000m and that 1m = 100cm. Considering that, which phrases are correct?\342\200\235</p>"
      content_id: "content_76"
    }
    interaction {
      id: "ItemSelectionInput"
      answer_groups {
        outcome {
          dest_state_name: "Unit conversion 3"
          labelled_as_correct: true
        }
        rule_specs {
          input {
            key: "x"
            value {
              translatable_set_of_normalized_string {
                normalized_strings: "ca_choices_78"
                normalized_strings: "ca_choices_81"
              }
            }
          }
          rule_type: "Equals"
        }
      }
    }
  }
}
states {
  key: "Unit Conversion 5a"
  value {
    name: "Unit Conversion 5a"
    content {
      html: "<p>Convert 600 cm to meters. How many meters would it be?</p>"
      content_id: "content_91"
    }
    interaction {
      id: "MultipleChoiceInput"
      answer_groups {
