id: "test_exp_id_6"
states {
  key: "Comparison Practice"
  value {
    name: "Comparison Practice"
    content {
      html: "<p>Omar was at the sports club and saw Coach Kim.</p><p>\342\200\234Good morning Coach Kim,\342\200\235 Omar said.</p><p>\342\200\234Hi Omar!\342\200\235 Coach Kim replied.</p><p>Omar looked at the leaderboard with each club member\342\200\231s long jump measurements on it. \342\200\234I want to know how to convert units, so that the leaderboard measurements are all in the same units.\342\200\235 he said.</p><p>\342\200\234Let\342\200\231s start by reviewing how to compare measurements that are in the same unit,\342\200\235 Coach Kim replied. \342\200\234Which of these would be the longest long jump?\342\200\235</p>"
      content_id: "content_0"
    }
    interaction {
      id: "MultipleChoiceInput"
      answer_groups {
        outcome {
          dest_state_name: "Unit Conversion Intro"
          feedback {
            html: "<p>Correct!</p>"
            content_id: "feedback_2"
          }
          labelled_as_correct: true
        }
        rule_specs {
          input {
            key: "x"
            value {
              signed_int: 0
            }
          }
          rule_type: "Equals"
        }
      }
      default_outcome {
        dest_state_name: "Comparison Practice"
        feedback {
          html: "<p>No, that\'s not correct.</p>"
          content_id: "default_outcome_1"
        }
      }
      customization_args {
        key: "showChoicesInShuffledOrder"
        value {
          bool_value: true
        }
      }
    }
  }
}
states {
  key: "Congratulations"
  value {
    name: "Congratulations"
    content {
      html: "<p>Congratulations on completing this lesson about unit conversion!</p>"
      content_id: "content_7"
    }
    interaction {
      id: "EndExploration"
    }
  }
}
states {
  key: "Happy Ending"
  value {
    name: "Happy Ending"
    content {
      html: "<p>Omar looked at the sorted leaderboard. \342\200\234I\342\200\231m in second place!\342\200\235 he said.</p>"
      content_id: "content_8"
    }
    interaction {
      id: "Continue"
      default_outcome {
        dest_state_name: "Congratulations"
      }
    }
  }
}
states {
  key: "Introduction"
  value {
    name: "Introduction"
    content {
      html: "<p>Omar wants to be the best long jumper in his sports club. He jumped 321 cm on his first try, but the club\342\200\231s leaderboard measurements are all in different units, so Omar can\342\200\231t compare his measurement with the others. Let\342\200\231s follow Omar as he learns about unit conversion.</p><p>Learning about measurements will require concentration, so find a quiet place to go through this story. If you make a mistake or get stuck, focus on understanding rather than just getting the correct answer as fast as possible. Try to learn from any mistakes!</p><p>Once you\342\200\231re ready, click Continue to get started!</p>"
      content_id: "content_11"
    }
    interaction {
      id: "Continue"
      default_outcome {
        dest_state_name: "Comparison Practice"
      }
      customization_args {
        key: "buttonText"
        value {
          normalized_string: "Continue"
        }
      }
    }
  }
}
states {
  key: "Leaderboard"
  value {
    name: "Leaderboard"
    content {
      html: "<p>How far did Bob jump in cm?</p>"
      content_id: "content_14"
    }
    interaction {
      id: "NumberWithUnits"
      answer_groups {
        outcome {
          dest_state_name: "Leaderboard 2"
          labelled_as_correct: true
        }
        rule_specs {
          input {
            key: "f"
            value {
              number_with_units {
                real: 200
                unit {
                  unit: "cm"
                  exponent: 1
                }
              }
            }
          }
          rule_type: "IsEqualTo"
        }
      }
    }
  }
}
