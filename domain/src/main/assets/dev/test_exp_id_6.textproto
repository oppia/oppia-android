}
states {
  key: "Unit Conversion Intro"
  value {
    name: "Unit Conversion Intro"
    content {
      html: "<p>\342\200\234That was easy,\342\200\235 Omar said. He pointed at the leaderboard. \342\200\234But the actual long jump measurements are in different units, like meters and centimeters.\342\200\235</p><p>\342\200\234Let\342\200\231s learn how to convert all these measurements to the same unit so you can compare easily,\342\200\235 Coach Kim replied. \342\200\234In the metric system, to convert a measurement from one unit to another, you first need to know the relationship between the two units.\342\200\235</p><p>\342\200\234What is a metric system? And what is the relationship between two units?\342\200\235 Omar asked.</p><p>\342\200\234Now, if \342\200\234centi\342\200\235 means one hundredth (1/100), what is the mathematical relationship between meters and centimeters?\342\200\235</p>"
      content_id: "content_36"
    }
    interaction {
      id: "MultipleChoiceInput"
      answer_groups {
        outcome {
          dest_state_name: "Unit Conversion 2"
          feedback {
            html: "<p>Correct!</p>"
            content_id: "feedback_38"
          }
          labelled_as_correct: true
        }
        rule_specs {
          input {
            key: "x"
            value {
              signed_int: 3
            }
          }
          rule_type: "Equals"
        }
      }
      default_outcome {
        dest_state_name: "Unit Conversion Intro"
      }
    }
  }
}
