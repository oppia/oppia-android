"""
Libraries for automating release operations, including uploading binaries and changelogs to the
Play Console and distributing builds via Firebase App Distribution.
"""

load("@io_bazel_rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")

kt_jvm_library(
    name = "play_console_client",
    srcs = ["PlayConsoleClient.kt"],
    visibility = ["//scripts:oppia_script_library_visibility"],
)

kt_jvm_library(
    name = "google_play_console_client",
    srcs = ["GooglePlayConsoleClient.kt"],
    visibility = ["//scripts:oppia_script_library_visibility"],
    deps = [
        ":play_console_client",
        "//scripts/src/java/org/oppia/android/scripts/release/model:track_response",
        "//scripts/src/java/org/oppia/android/scripts/release/remote:play_console_service",
        "//third_party:com_squareup_okhttp3_okhttp",
        "//third_party:com_squareup_retrofit2_converter-moshi",
        "//third_party:com_squareup_retrofit2_retrofit",
    ],
)

kt_jvm_library(
    name = "fake_play_console_client",
    testonly = True,
    srcs = ["FakePlayConsoleClient.kt"],
    visibility = ["//scripts:oppia_script_test_visibility"],
    deps = [":play_console_client"],
)

kt_jvm_library(
    name = "version_inversion_check",
    srcs = ["VersionInversionCheck.kt"],
    visibility = ["//scripts:oppia_script_library_visibility"],
    deps = [":play_console_client"],
)

kt_jvm_library(
    name = "pending_release_check",
    srcs = ["PendingReleaseCheck.kt"],
    visibility = ["//scripts:oppia_script_library_visibility"],
    deps = [":play_console_client"],
)

kt_jvm_library(
    name = "changelog_existence_check",
    srcs = ["ChangelogExistenceCheck.kt"],
    visibility = ["//scripts:oppia_script_library_visibility"],
)

# Wraps all release script libraries for use by the top-level binary in //scripts.
# Uses oppia_script_binary_visibility so //scripts:upload_binary_to_play_console can see it.
kt_jvm_library(
    name = "upload_binary_to_play_console_lib",
    srcs = ["UploadBinaryToPlayConsole.kt"],
    visibility = ["//scripts:oppia_script_binary_visibility"],
    deps = [
        ":changelog_existence_check",
        ":google_play_console_client",
        ":pending_release_check",
        ":version_inversion_check",
    ],
)

# Wraps the UploadChangelogToPlayConsole script for use by the top-level binary in //scripts.
# Uses oppia_script_binary_visibility so //scripts:upload_changelog_to_play_console can see it.
kt_jvm_library(
    name = "upload_changelog_to_play_console_lib",
    srcs = ["UploadChangelogToPlayConsole.kt"],
    visibility = ["//scripts:oppia_script_binary_visibility"],
    deps = [":play_console_client"],
)
