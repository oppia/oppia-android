"""
Libraries for automating release operations, including uploading changelogs to the Play Console.

Note: PR 1.4 (upload-binary-to-play-console) also adds targets to this BUILD file
(play_console_client, fake_play_console_client, google_play_console_client, etc.).
Those targets will be available in this package once PR 1.4 merges into develop.
"""

load("@io_bazel_rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")

kt_jvm_library(
    name = "upload_changelog_to_play_console_lib",
    srcs = ["UploadChangelogToPlayConsole.kt"],
    visibility = ["//scripts:oppia_script_binary_visibility"],
    deps = [
        # play_console_client is provided by PR 1.4. This target will not build
        # standalone until that PR merges into develop.
        ":play_console_client",
    ],
)

